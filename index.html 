<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#102b59">
  <title>CampusHub | College Portal</title>
  <style>
    :root{--navy:#102b59;--blue:#2457a7;--ink:#172554;--muted:#64748b;--bg:#f3f6fb;--line:#e5eaf2;--white:#fff;--green:#16865b}
    *{box-sizing:border-box}body{margin:0;font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:var(--ink)}
    button,select{font:inherit}button{cursor:pointer}
    .topbar{background:var(--navy);color:#fff;padding:18px max(20px,calc((100% - 1180px)/2));display:flex;align-items:center;justify-content:space-between;gap:16px}
    .brand{display:flex;align-items:center;gap:11px;font-size:22px;font-weight:800;letter-spacing:.2px}.logo{width:38px;height:38px;border-radius:12px;background:#fff;color:var(--navy);display:grid;place-items:center;font-weight:900}
    .top-right{display:flex;align-items:center;gap:12px}.top-right select{background:#1b3d75;color:#fff;border:1px solid #53709f;border-radius:9px;padding:9px;max-width:180px}
    .layout{max-width:1180px;margin:24px auto;padding:0 18px;display:grid;grid-template-columns:230px 1fr;gap:22px}
    aside{background:#fff;border:1px solid var(--line);border-radius:16px;padding:16px;height:max-content;position:sticky;top:14px}
    .nav-label{font-size:11px;color:#94a3b8;font-weight:800;letter-spacing:1px;margin:9px 10px}
    .nav-btn{width:100%;border:0;background:transparent;text-align:left;padding:12px;border-radius:10px;color:#475569;margin:2px 0;font-weight:600}
    .nav-btn:hover,.nav-btn.active{background:#eaf1fc;color:var(--blue)}
    main{min-width:0}.welcome{background:linear-gradient(115deg,#102b59,#2457a7);color:#fff;border-radius:18px;padding:26px;margin-bottom:18px;display:flex;justify-content:space-between;align-items:center;gap:20px}
    .welcome h1{font-size:27px;margin:0 0 8px}.welcome p{margin:0;color:#dbeafe;line-height:1.5}.welcome .date{font-size:13px;color:#dbeafe;text-align:right}
    .grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px;margin-bottom:18px}
    .stat,.panel,.module{background:#fff;border:1px solid var(--line);border-radius:15px;padding:18px}
    .stat small{color:var(--muted);font-weight:600}.stat strong{display:block;font-size:27px;margin:9px 0 3px}.stat span{font-size:12px;color:var(--green)}
    .content-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:16px}.panel h2{font-size:17px;margin:0 0 15px}.item{padding:12px 0;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:12px;align-items:center}.item:first-of-type{border-top:0}.item b{font-size:14px}.item small{display:block;color:var(--muted);margin-top:5px}.pill{font-size:11px;padding:5px 9px;border-radius:20px;background:#eaf1fc;color:var(--blue);white-space:nowrap}
    .modules{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}.module{min-height:126px}.module .symbol{font-size:23px}.module h3{font-size:15px;margin:10px 0 5px}.module p{font-size:12px;color:var(--muted);line-height:1.4;margin:0}
    .section-title{display:flex;justify-content:space-between;align-items:center;margin:22px 0 13px}.section-title h2{font-size:18px;margin:0}
    .notice{background:#fff8e7;border:1px solid #f5dfaa;color:#795617;border-radius:12px;padding:12px 14px;font-size:13px;line-height:1.5;margin-bottom:16px}
    footer{text-align:center;color:#94a3b8;font-size:12px;padding:26px}
    .mobile-menu{display:none}.hidden{display:none!important}
    @media(max-width:850px){.layout{grid-template-columns:1fr}.grid{grid-template-columns:repeat(2,1fr)}aside{position:static;display:grid;grid-template-columns:repeat(2,1fr);gap:3px}.nav-label{grid-column:1/-1}.content-grid{grid-template-columns:1fr}}
    @media(max-width:520px){.topbar{padding:14px 16px}.brand{font-size:19px}.top-right select{max-width:125px;font-size:12px}.layout{margin:15px auto;padding:0 12px;gap:14px}.welcome{padding:20px;display:block}.welcome h1{font-size:23px}.welcome .date{text-align:left;margin-top:13px}.grid{gap:9px}.stat{padding:14px}.stat strong{font-size:23px}.modules{grid-template-columns:repeat(2,minmax(0,1fr))}aside{grid-template-columns:1fr 1fr;padding:10px}.nav-btn{font-size:12px;padding:10px 8px}}
  </style>
</head>
<body>
<header class="topbar">
  <div class="brand"><div class="logo">CH</div> CampusHub</div>
  <div class="top-right">
    <label for="role" style="font-size:12px;color:#dbeafe">Demo view</label>
    <select id="role" aria-label="Choose demo role">
      <option>Student</option><option>Lecturer</option><option>College Admin</option><option>Registrar</option><option>Parent / Guardian</option><option>Finance Officer</option><option>Librarian</option><option>HOD</option>
    </select>
  </div>
</header>
<div class="layout">
  <aside aria-label="Main navigation">
    <div class="nav-label">PORTAL MENU</div>
    <button class="nav-btn active" data-page="dashboard">⌂ &nbsp; Dashboard</button>
    <button class="nav-btn" data-page="courses">▤ &nbsp; My Courses</button>
    <button class="nav-btn" data-page="timetable">▦ &nbsp; Timetable</button>
    <button class="nav-btn" data-page="attendance">✓ &nbsp; Attendance</button>
    <button class="nav-btn" data-page="results">▣ &nbsp; Exams & Results</button>
    <button class="nav-btn" data-page="fees">＄ &nbsp; Fees & Finance</button>
    <button class="nav-btn" data-page="library">▥ &nbsp; Library</button>
    <button class="nav-btn" data-page="messages">✉ &nbsp; Messages</button>
    <div class="nav-label">GENERAL</div>
    <button class="nav-btn" data-page="services">✚ &nbsp; Student Services</button>
    <button class="nav-btn" data-page="help">? &nbsp; Help & Support</button>
  </aside>
  <main>
    <div class="notice"><b>Preview version:</b> This is the first visual CampusHub demo. The information shown is sample data. Secure accounts, live records and payments are not connected yet.</div>
    <section id="dashboard">
      <div class="welcome">
        <div><h1 id="greeting">Welcome back, Student!</h1><p>Your college information, learning activities and updates in one place.</p></div>
        <div class="date" id="today"></div>
      </div>
      <div class="grid">
        <div class="stat"><small>Enrolled courses</small><strong>6</strong><span>Current semester</span></div>
        <div class="stat"><small>Attendance</small><strong>92%</strong><span>Good standing</span></div>
        <div class="stat"><small>Current GPA</small><strong>3.65</strong><span>Sample result</span></div>
        <div class="stat"><small>Pending tasks</small><strong>3</strong><span>Check assignments</span></div>
      </div>
      <div class="content-grid">
        <div class="panel"><h2>Upcoming activities</h2>
          <div class="item"><div><b>Database Systems</b><small>Lecture · Room B204</small></div><span class="pill">Today · 10:00</span></div>
          <div class="item"><div><b>Web Development assignment</b><small>Submit your project</small></div><span class="pill">Tomorrow</span></div>
          <div class="item"><div><b>Academic advising</b><small>Student services</small></div><span class="pill">Friday</span></div>
        </div>
        <div class="panel"><h2>Latest announcements</h2>
          <div class="item"><div><b>Semester registration</b><small>Check your registration details with the registrar.</small></div></div>
          <div class="item"><div><b>Library hours</b><small>Library opening hours are posted on campus.</small></div></div>
          <div class="item"><div><b>Welcome to CampusHub</b><small>Your college portal preview is ready.</small></div></div>
        </div>
      </div>
      <div class="section-title"><h2>Quick access</h2></div>
      <div class="modules">
        <div class="module"><div class="symbol">📚</div><h3>Learning materials</h3><p>Course notes and resources</p></div>
        <div class="module"><div class="symbol">🗓️</div><h3>Class timetable</h3><p>View weekly class schedule</p></div>
        <div class="module"><div class="symbol">📝</div><h3>Assignments</h3><p>Tasks and submission dates</p></div>
        <div class="module"><div class="symbol">📊</div><h3>Academic results</h3><p>Grades and GPA overview</p></div>
        <div class="module"><div class="symbol">💳</div><h3>Fee information</h3><p>View fee status and guidance</p></div>
        <div class="module"><div class="symbol">💬</div><h3>Messages</h3><p>College notices and updates</p></div>
      </div>
    </section>
    <section id="other-page" class="hidden">
      <div class="welcome"><div><h1 id="page-heading">My Courses</h1><p id="page-description">Your college information in one place.</p></div></div>
      <div class="panel"><h2 id="page-subheading">Coming soon</h2><p style="color:#64748b;line-height:1.7">This section is part of the CampusHub plan. It will be connected to secure college records in a later development stage. No real student data is stored in this preview.</p></div>
    </section>
  </main>
</div>
<footer>CampusHub · College Portal Preview · Built as a free starter website</footer>
<script>
  const descriptions = {
    courses:["My Courses","View your enrolled courses, lecturers and learning materials."],
    timetable:["Timetable","Check your weekly classes, rooms and lecture times."],
    attendance:["Attendance","Review attendance records and class participation."],
    results:["Exams & Results","View examination information, grades and academic progress."],
    fees:["Fees & Finance","Review fee information and payment guidance. No payments are processed here."],
    library:["Library","Explore library resources and borrowing information."],
    messages:["Messages","College announcements and communication."],
    services:["Student Services","Find student support, advising and campus services."],
    help:["Help & Support","Get help using the CampusHub portal."]
  };
  const navButtons = document.querySelectorAll(".nav-btn");
  navButtons.forEach(button => button.addEventListener("click", () => {
    navButtons.forEach(item => item.classList.remove("active"));
    button.classList.add("active");
    const page = button.dataset.page;
    const isDashboard = page === "dashboard";
    document.getElementById("dashboard").classList.toggle("hidden", !isDashboard);
    document.getElementById("other-page").classList.toggle("hidden", isDashboard);
    if (!isDashboard) {
      const info = descriptions[page] || ["CampusHub","Portal information"];
      document.getElementById("page-heading").textContent = info[0];
      document.getElementById("page-description").textContent = info[1];
      document.getElementById("page-subheading").textContent = info[0] + " · Coming soon";
    }
  }));
  document.getElementById("role").addEventListener("change", event => {
    const role = event.target.value;
    document.getElementById("greeting").textContent = "Welcome back, " + role + "!";
  });
  document.getElementById("today").textContent = new Date().toLocaleDateString(undefined,{weekday:"long",year:"numeric",month:"long",day:"numeric"});
</script>
</body>
</html>
